---
import Base from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CALCS } from '../../data/calculators.js';
---

<Base title="Todas as calculadoras online" description="Lista completa de calculadoras online gratuitas para idade, IMC, porcentagem, datas, unidades, temperatura, juros e sorteios.">
  <Breadcrumbs />

  <h1 class="text-2xl font-semibold mb-4">Todas as calculadoras</h1>

  <section class="prose dark:prose-invert mb-4">
    <p>Encontre ferramentas gratuitas do Conta Rápida para resolver contas do dia a dia sem cadastro: idade, IMC, porcentagem, datas, unidades, temperatura, juros, regra de três, horas, palavras e sorteios.</p>
  </section>

  <label class="grid gap-1 mb-4 max-w-md">
    <span class="text-sm">Buscar calculadora</span>
    <input
      id="calc-search"
      type="search"
      class="input border rounded p-2"
      placeholder="Ex.: porcentagem, IMC, dias"
      autocomplete="off"
    />
  </label>

  <ul id="calc-list" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {CALCS.map(i => (
      <li
        class="group p-4 rounded-xl border border-gray-200 dark:border-gray-800 hover:shadow-sm transition"
        data-search={`${i.title} ${i.desc}`.toLowerCase()}
      >
        <a href={i.href} class="no-underline block">
          <div class="flex items-start gap-3">
            <div class="text-2xl">{i.icon}</div>
            <div>
              <h3 class="font-semibold group-hover:underline">{i.title}</h3>
              {i.desc && <p class="text-sm opacity-70">{i.desc}</p>}
            </div>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <p id="calc-empty" class="mt-4 text-sm opacity-75" hidden>Nenhuma calculadora encontrada.</p>

  <section class="prose dark:prose-invert mt-8">
    <h2>Como escolher a calculadora certa</h2>
    <p>Para contas pessoais rápidas, comece pelas calculadoras de idade, IMC, porcentagem e dias entre datas. Para estudos e trabalho, use regra de três, conversor de unidades, conversor de horas, temperatura e contador de palavras.</p>
  </section>

  <AdSlot slotId="6940589775" />

  <script is:inline>
    const search = document.getElementById('calc-search');
    const items = Array.from(document.querySelectorAll('#calc-list li'));
    const empty = document.getElementById('calc-empty');

    search.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      let visible = 0;

      items.forEach((item) => {
        const match = !q || item.dataset.search.includes(q);
        item.hidden = !match;
        if (match) visible += 1;
      });

      empty.hidden = visible > 0;
    });
  </script>
</Base>
